{
  "name": "aispa",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm --prefix apps/api run dev\" \"npm --prefix apps/web run dev\"",
    "build": "npm --prefix apps/api run build && npm --prefix apps/web run build",
    "install:all": "npm --prefix apps/api install && npm --prefix apps/web install",
    "db:migrate": "npm --prefix apps/api run db:migrate"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@libsql/client": "^0.14.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "serverless-http": "^3.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.10",
    "concurrently": "^9.1.2",
    "typescript": "^5.8.2"
  }
}
